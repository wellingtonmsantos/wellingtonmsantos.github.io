<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta
    name="viewport" content="width=device-width, initial-scale=1">
    <!-- SEO Básico -->
    <title>Wellington Santos | Performance Humana & Data Science</title>
    <meta
      name="description"
      content="Especialista em Performance Humana & Data Science. Combinando evidência científica, prática de treino e
        tecnologia para resultados reais e mensuráveis.">
    <meta
      name="keywords"
      content="performance humana, data science, treinamento físico, crossfit, personal trainer, ciência do esporte, HYROX">
    <meta
    name="author" content="Wellington Santos"> <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Wellington Santos | Performance Humana & Data Science">
    <meta
      property="og:description"
      content="Da ciência ao resultado real. Especialista em Performance Humana & Data Science.">
    <meta property="og:image" content="/assets/img/wellington-photo.png">
    <meta
    property="og:url" content="https://wellingtonsantos.com"> <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="Wellington Santos | Performance Humana & Data Science">
    <meta
      property="twitter:description"
      content="Da ciência ao resultado real. Especialista em Performance Humana & Data Science.">
    <meta
    property="twitter:image" content="/assets/img/wellington-photo.png"> <!-- Theme Color -->
    <meta name="theme-color" content="#147aff">
    <link rel="icon" type="image/svg+xml" href="favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/style.css">
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner container">
        <a
          class="site-header__logo" href="#hero">
          {# <span class="site-header__logo-mark">WS</span> #}
          <span class="site-header__logo-text">Wellington Santos</span>
        </a>
        <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
          <span class="visually-hidden">Abrir menu</span>
          <span class="site-header__toggle-line" aria-hidden="true"></span>
          <span class="site-header__toggle-line" aria-hidden="true"></span>
          <span class="site-header__toggle-line" aria-hidden="true"></span>
        </button>
        <nav class="site-header__nav" id="primary-nav" aria-label="Navegação principal">
          <ul class="site-header__nav-list">
            <li><a href="#hero">Início</a></li>
            <li><a href="#sobre">Sobre</a></li>
            <li><a href="#casos">Clientes</a></li>
            <li><a href="#artigos">Conteúdo</a></li>
            <li><a href="#publicacoes">Publicações</a></li>
            {# <li>
                                                                                                                                                                         <a href="#formacoes">Formações</a>
                                                                                                                                                                         </li> #}
          </ul>
        </nav>
      </div>
    </header>
    <main>
      {# Controle de exibicao em _data/site.json -> sections.<id> #}
      {% if site.sections.hero | default(true) %}
        <section class="hero section" id="hero">
          <div class="hero-data-viz"></div>
          <div class="container hero__grid">
            <div class="hero__content">
              <div class="hero__badges" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
                <span style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 999px; border: 1px solid var(--color-outline); color: var(--color-muted);">Personal Trainer</span>
                <span style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 999px; border: 1px solid var(--color-outline); color: var(--color-muted);">CrossFit</span>
                <span style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 999px; border: 1px solid var(--color-outline); color: var(--color-muted);">Treino Híbrido</span>
                <span style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 999px; border: 1px solid rgba(20,122,255,0.4); color: var(--color-accent);">Online & Presencial</span>
              </div>
              <h1 class="hero__title cyber-gradient-text" style="font-weight: 800; font-size: clamp(2.5rem, 6vw, 4rem);">
                Resultados acima<br>da média.
                <span style="font-weight: 400; font-size: clamp(1.2rem, 3vw, 1.75rem); display: block; margin-top: 0.75rem; background: none; -webkit-text-fill-color: var(--color-muted);">Não é promessa — é método.</span>
              </h1>
              <p class="hero__description">
                Trabalho com quem quer evoluir de verdade: mais força, melhor condicionamento e progresso mensurável. Sem achismo. Sem estagnação.
              </p>
              <div class="hero__actions">
                <a class="button button--primary" href="https://wa.me/5519920034839">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51h-.57c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.052 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  Quero começar agora
                </a>
                <a class="button button--ghost" href="#casos">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  Ver resultados de alunos
                </a>
              </div>
              <dl class="hero__metrics" style="display: flex; gap: 2rem; flex-wrap: wrap; margin-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.5rem;">
                <div style="display: flex; align-items: center; gap: 0.8rem;">
                  <div style="color: var(--color-accent);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path></svg></div>
                  <div>
                    <dt style="font-size: 0.8rem; color: var(--color-muted);">Experiência</dt>
                    <dd style="margin: 0; font-size: 1.5rem; font-weight: 700;">10+ anos</dd>
                  </div>
                </div>
                <div style="display: flex; align-items: center; gap: 0.8rem;">
                  <div style="color: var(--color-accent);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></div>
                  <div>
                    <dt style="font-size: 0.8rem; color: var(--color-muted);">Publicações científicas</dt>
                    <dd style="margin: 0; font-size: 1.5rem; font-weight: 700;">13 artigos</dd>
                  </div>
                </div>
                <div style="display: flex; align-items: center; gap: 0.8rem;">
                  <div style="color: var(--color-accent);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
                  <div>
                    <dt style="font-size: 0.8rem; color: var(--color-muted);">Alunos transformados</dt>
                    <dd style="margin: 0; font-size: 1.5rem; font-weight: 700;">+18</dd>
                  </div>
                </div>
              </dl>
            </div>
            <div class="hero__image-wrapper fade-in">
              <div class="hero__carousel">
                <img src="/assets/img/wellington-foto2.png"      alt="Wellington Santos" class="hero__carousel-img is-active">
                <img src="/assets/img/wellington-squat.png"      alt="Wellington Santos treinando" class="hero__carousel-img">
                <img src="/assets/img/wellington-handstand.png"  alt="Wellington Santos handstand" class="hero__carousel-img">
              </div>

            </div>
          </div>
        </section>
      {% endif %}
      {% if site.sections.sobre | default(true) %}
        <section class="about section" id="sobre">
          <div class="container">
            <h2 class="about__main-title">Por que acima da média?</h2>
            <div class="about__journey">
              <div class="about__photo fade-in" style="position: relative; overflow: hidden; padding: 0; min-height: 500px; display: flex; align-items: center; justify-content: center; background: transparent;">
                <img src="/assets/img/wellington-perfil.png" alt="Wellington Santos" style="width: 100%; height: 100%; object-fit: cover; object-position: center top; position: absolute; top: 0; left: 0;">
              </div>
              <div class="about__content bento-grid">
                <article class="about__story fade-in glass-panel bento-card--large" style="padding: 1.5rem;">
                  <h3 class="about__story-title" style="display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    Base científica real
                  </h3>
                  <p>
                    13 artigos publicados em periódicos internacionais. Não aplico o que está na moda — aplico o que foi testado e comprovado. Cada protocolo tem respaldo em evidência científica.
                  </p>
                </article>
                <article class="about__story fade-in glass-panel" style="padding: 1.5rem;">
                  <h3 class="about__story-title" style="display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    Dados, não achismo
                  </h3>
                  <p>
                    Carga, volume e recuperação são monitorados. Você vê a evolução mês a mês, com números reais — não sensação. O que não é medido, não é gerenciado.
                  </p>
                </article>
                <article class="about__story fade-in glass-panel" style="padding: 1.5rem;">
                  <h3 class="about__story-title" style="display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    Método que se adapta a você
                  </h3>
                  <p>
                    Personal Trainer, CrossFit ou Treino Híbrido — presencial ou online. O protocolo encaixa na sua rotina, não o contrário. Sem desculpa para não evoluir.
                  </p>
                </article>
                <div class="about__cta" style="margin-top: 1rem;">
                  <a class="button button--primary" href="https://wa.me/5519920034839" style="width: 100%;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51h-.57c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.052 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    Começar minha transformação
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      {% endif %}
      {% if site.sections.casos | default(true) %}
        <section class="cases section" id="casos">
          <div class="container section__header">
            <h2>Clientes</h2>
            <p>Transformações reais de quem treinou comigo</p>
          </div>
          {# Filtros de busca #}
          <div class="container">
            <div class="case-filters">
              <div class="case-filter-row">
                <span class="case-filter-row__label">Modalidade</span>
                <div class="case-pills" data-filter="modalidade">
                  <button class="case-pill is-active" data-value="" type="button">Todos</button>
                  <button class="case-pill" data-value="Personal Trainer" type="button">Personal</button>
                  <button class="case-pill" data-value="CrossFit" type="button">CrossFit</button>
                  <button class="case-pill" data-value="Hyrox" type="button">HYROX</button>
                  <button class="case-pill" data-value="Treino Híbrido" type="button">Híbrido</button>
                  <button class="case-pill" data-value="Musculação" type="button">Musculação</button>
                </div>
              </div>
              <div class="case-filter-row">
                <span class="case-filter-row__label">Formato</span>
                <div class="case-pills" data-filter="formato">
                  <button class="case-pill is-active" data-value="" type="button">Todos</button>
                  <button class="case-pill" data-value="Presencial" type="button">Presencial</button>
                  <button class="case-pill" data-value="Online" type="button">Online</button>
                </div>
              </div>
            </div>
          </div>
          <div class="container">
            <div class="cases__grid bento-grid" data-category="casos">
              {% set casosVisiveis = collections.casos | visibleOnly %}
              {% if casosVisiveis.length > 0 %}
                {% for caso in casosVisiveis %}
                  {% include "partials/case-card.njk" %}
                {% endfor %}
              {% else %}
                <div class="articles__empty">
                  <h3>Nenhum conteúdo disponível</h3>
                  <p>Volte em breve para conferir novidades nesta categoria.</p>
                </div>
              {% endif %}
            </div>
            {% if casosVisiveis.length > 6 %}
              <div class="articles__load-more">
                <button class="button button--ghost articles__load-more-btn" data-category="casos">
                  Ver mais casos
                </button>
              </div>
            {% endif %}
          </div>
        </section>
      {% endif %}
      {% if site.sections.projetos | default(true) %}
        <section class="projects section" id="projetos">
          <div class="container section__header">
            <h2>Projetos em destaque</h2>
            <p>
              Apresentação de projetos: Educacionais e tecnológicos.
            </p>
          </div>
          {# Dropdown de categorias de projetos (Desktop e Mobile) #}
          <div class="container">
            <div class="tabs-with-label">
              <label class="tabs-label">Categoria:</label>
              <div class="articles-tabs" role="tablist" aria-label="Categorias de projetos">
                <button
                  class="articles-tabs__tab is-active"
                  role="tab"
                  aria-selected="true"
                  aria-controls="panel-projetos-todos"
                  id="tab-projetos-todos"
                  data-category="todos">
                  Todos
                </button>
                <button
                  class="articles-tabs__tab"
                  role="tab"
                  aria-selected="false"
                  aria-controls="panel-tecnologia-proj"
                  id="tab-tecnologia-proj"
                  data-category="tecnologia">
                  Tecnologia
                </button>
                <button
                  class="articles-tabs__tab"
                  role="tab"
                  aria-selected="false"
                  aria-controls="panel-palestras"
                  id="tab-palestras"
                  data-category="palestras">
                  Palestras
                </button>
                <button
                  class="articles-tabs__tab"
                  role="tab"
                  aria-selected="false"
                  aria-controls="panel-outros"
                  id="tab-outros"
                  data-category="outros">
                  Outros
                </button>
              </div>
              {# Dropdown principal #}
              <div class="articles-tabs-dropdown">
                <button
                  class="articles-tabs-dropdown__button"
                  type="button"
                  aria-expanded="false"
                  aria-controls="dropdown-menu-projetos"
                  aria-label="Selecionar categoria de projeto">
                  <span class="articles-tabs-dropdown__button-text">Todos</span>
                  <span class="articles-tabs-dropdown__button-icon" aria-hidden="true">▼</span>
                </button>
                <div class="articles-tabs-dropdown__menu" id="dropdown-menu-projetos" role="menu" aria-hidden="true">
                  <button
                    class="articles-tabs-dropdown__option is-active"
                    role="menuitem"
                    data-category="todos"
                    data-panel="panel-projetos-todos">
                    Todos
                  </button>
                  <button
                    class="articles-tabs-dropdown__option"
                    role="menuitem"
                    data-category="tecnologia"
                    data-panel="panel-tecnologia-proj">
                    Tecnologia
                  </button>
                  <button class="articles-tabs-dropdown__option" role="menuitem" data-category="palestras" data-panel="panel-palestras">
                    Palestras
                  </button>
                  <button class="articles-tabs-dropdown__option" role="menuitem" data-category="outros" data-panel="panel-outros">
                    Outros
                  </button>
                </div>
              </div>
            </div>
          </div>
          {# Panel: Todos os projetos #}
          <div class="container">
            <div
              class="articles-tabs__panel is-active"
              role="tabpanel"
              id="panel-projetos-todos"
              aria-labelledby="tab-projetos-todos">
              <div class="articles__grid bento-grid" data-category="todos">
                {% set todosProjetos = collections.projetos | visibleOnly %}
                {% if todosProjetos.length > 0 %}
                  {% for projeto in todosProjetos %}
                    {% include "partials/project-card.njk" %}
                  {% endfor %}
                {% else %}
                  <div class="articles__empty">
                    <h3>Nenhum conteúdo disponível</h3>
                    <p>Volte em breve para conferir novidades nesta categoria.</p>
                  </div>
                {% endif %}
              </div>
              {% if todosProjetos.length > 6 %}
                <div class="articles__load-more">
                  <button class="button button--ghost articles__load-more-btn" data-category="todos">
                    Ver mais projetos
                  </button>
                </div>
              {% endif %}
            </div>
            {# Panel: Tecnologia #}
            <div
              class="articles-tabs__panel"
              role="tabpanel"
              id="panel-tecnologia-proj"
              aria-labelledby="tab-tecnologia-proj"
              hidden>
              <div class="articles__grid bento-grid" data-category="tecnologia">
                {% set projetosTecnologia = collections.projetos | visibleOnly | filterByCategory("tecnologia") %}
                {% if projetosTecnologia.length > 0 %}
                  {% for projeto in projetosTecnologia %}
                    {% include "partials/project-card.njk" %}
                  {% endfor %}
                {% else %}
                  <div class="articles__empty">
                    <h3>Nenhum conteúdo disponível</h3>
                    <p>Volte em breve para conferir novidades nesta categoria.</p>
                  </div>
                {% endif %}
              </div>
              {% if projetosTecnologia.length > 6 %}
                <div class="articles__load-more">
                  <button class="button button--ghost articles__load-more-btn" data-category="tecnologia">
                    Ver mais projetos
                  </button>
                </div>
              {% endif %}
            </div>
            {# Panel: Palestras #}
            <div class="articles-tabs__panel" role="tabpanel" id="panel-palestras" aria-labelledby="tab-palestras" hidden>
              <div class="articles__grid bento-grid" data-category="palestras">
                {% set projetosPalestras = collections.projetos | visibleOnly | filterByCategory("palestras") %}
                {% if projetosPalestras.length > 0 %}
                  {% for projeto in projetosPalestras %}
                    {% include "partials/project-card.njk" %}
                  {% endfor %}
                {% else %}
                  <div class="articles__empty">
                    <h3>Nenhum conteúdo disponível</h3>
                    <p>Volte em breve para conferir novidades nesta categoria.</p>
                  </div>
                {% endif %}
              </div>
              {% if projetosPalestras.length > 6 %}
                <div class="articles__load-more">
                  <button class="button button--ghost articles__load-more-btn" data-category="palestras">
                    Ver mais projetos
                  </button>
                </div>
              {% endif %}
            </div>
            {# Panel: Outros #}
            <div class="articles-tabs__panel" role="tabpanel" id="panel-outros" aria-labelledby="tab-outros" hidden>
              <div class="articles__grid bento-grid" data-category="outros">
                {% set projetosOutros = collections.projetos | visibleOnly | filterByCategory("outros") %}
                {% if projetosOutros.length > 0 %}
                  {% for projeto in projetosOutros %}
                    {% include "partials/project-card.njk" %}
